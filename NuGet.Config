<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!--
    Server/HideoutShootout.Server.csproj restores the SPTarkov.* packages from nuget.org.
    If the machine-level NuGet.Config enables packageSourceMapping without listing
    nuget.org, those packages are excluded from restore with NU1101 even though the
    source is declared above (same issue SPT-COTI hit). Declaring the mapping locally
    keeps the fix inside this repo.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
