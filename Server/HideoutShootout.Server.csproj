<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
	<TargetFramework>net9.0</TargetFramework>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<OutputType>Library</OutputType>
	<AssemblyName>HideoutShootout.Server</AssemblyName>
	<RootNamespace>HideoutShootout.Server</RootNamespace>
	<AssemblyVersion>1.1.0</AssemblyVersion>
	<FileVersion>$(AssemblyVersion)</FileVersion>
	<Version>$(AssemblyVersion)</Version>
	<!-- SPT 4.0.13 publishes its server libraries as NuGet packages instead of the raw
		 DLL folder 4.1 mods referenced directly, so SptServerDllDir/HintPath no longer
		 apply - only the deploy target below still needs an install path. -->
	<SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.0.10</SptRoot>
	<ServerModDeployDir Condition="'$(ServerModDeployDir)' == ''">$(SptRoot)\user\mods\hideoutshootout-server</ServerModDeployDir>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="SPTarkov.Common" Version="4.0.13" ExcludeAssets="runtime" />
	<PackageReference Include="SPTarkov.DI" Version="4.0.13" ExcludeAssets="runtime" />
	<PackageReference Include="SPTarkov.Reflection" Version="4.0.13" ExcludeAssets="runtime" />
	<PackageReference Include="SPTarkov.Server.Core" Version="4.0.13" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
	<Folder Include="wwwroot\" />
  </ItemGroup>

	<Target Name="CopyToSptServerMods" AfterTargets="Build">
	<ItemGroup>
	  <OutputDll Include="$(TargetPath)" />
	  <OutputPdb Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
	  <Resources Include="$(ProjectDir)Resources\**\*.*" Condition="Exists('$(ProjectDir)Resources')" />
	  <WebAssets Include="$(ProjectDir)wwwroot\**\*.*" Condition="Exists('$(ProjectDir)wwwroot')" />
	</ItemGroup>

	<MakeDir Directories="$(ServerModDeployDir)" />
	<Copy SourceFiles="@(OutputDll)" DestinationFolder="$(ServerModDeployDir)" />
	<Copy SourceFiles="@(OutputPdb)" DestinationFolder="$(ServerModDeployDir)" SkipUnchangedFiles="true" />
	<Copy SourceFiles="@(Resources)" DestinationFolder="$(ServerModDeployDir)\Resources\%(RecursiveDir)" SkipUnchangedFiles="true" />
	<Copy SourceFiles="@(WebAssets)" DestinationFolder="$(ServerModDeployDir)\wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
